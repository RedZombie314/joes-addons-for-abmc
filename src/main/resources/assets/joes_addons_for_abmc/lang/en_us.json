  "joes_addons_for_abmc.config.sound.bell_tinnitus": "Bell staff: tinnitus sound",
  "joes_addons_for_abmc.config.sound.bell_tinnitus.tooltip": "Whether the Bell staff plays a tinnitus (ear ringing) sound when rung. When disabled, ringing still silences other sounds (the sound-dampening effect remains), but no ear-ringing sound plays.",
  "joes_addons_for_abmc.config.sound.redstone_laser_sounds": "Redstone block staff: laser sounds",
  "joes_addons_for_abmc.config.sound.redstone_laser_sounds.tooltip": "Whether the Redstone Block staff plays laser sound effects (start / looping / end) when firing. When disabled, the laser beam still renders but makes no sound.",
  "joes_addons_for_abmc.config.sound.command_fly_sound": "Command block staff: flight sound",
  "joes_addons_for_abmc.config.sound.command_fly_sound.tooltip": "Whether the Command Block staff plays a flight sound while the player is flying with it.",
  "joes_addons_for_abmc.config.line_converge_offset": "Line / Converge Offset",
  "joes_addons_for_abmc.config.line_converge_offset.converge_offset_x": "X (right) offset",
  "joes_addons_for_abmc.config.line_converge_offset.converge_offset_x.tooltip": "Horizontal (right) offset in blocks of the line emitter / converge point relative to the staff holder. Applies to all staffs that emit a line or converge particles: redstone laser, cobweb beam, enchant link, command feedback line, Omega absorb. The offset is relative to the holder's head direction (visual angle, including look-up/down pitch), so the position moves relatively when the holder looks up or down. Range -10 to 10.",
  "joes_addons_for_abmc.config.line_converge_offset.converge_offset_y": "Y (up) offset",
  "joes_addons_for_abmc.config.line_converge_offset.converge_offset_y.tooltip": "Vertical (up) offset in blocks of the line emitter / converge point relative to the staff holder. Relative to the holder's head direction; moves relatively when looking up or down. Range -10 to 10.",
  "joes_addons_for_abmc.config.line_converge_offset.converge_offset_z": "Z (forward) offset",
  "joes_addons_for_abmc.config.line_converge_offset.converge_offset_z.tooltip": "Forward (front) offset in blocks of the line emitter / converge point relative to the staff holder. Relative to the holder's head direction; moves relatively when looking up or down. Range -10 to 10.",
  "joes_addons_for_abmc.config.line_converge_offset.third_person_offset_x": "Third-person X (right) offset",
  "joes_addons_for_abmc.config.line_converge_offset.third_person_offset_x.tooltip": "Extra X (right) offset in blocks applied on top of the converge offset only in third person or when another holder uses the staff, to fine-tune the position difference (e.g. height) of the staff between first and third person views. Also relative to the holder's head direction; moves relatively when looking up or down. Range -10 to 10.",
  "joes_addons_for_abmc.config.line_converge_offset.third_person_offset_y": "Third-person Y (up) offset",
  "joes_addons_for_abmc.config.line_converge_offset.third_person_offset_y.tooltip": "Extra Y (up) offset in blocks applied only in third person or when another holder uses the staff. Also relative to the holder's head direction; moves relatively when looking up or down. Range -10 to 10.",
  "joes_addons_for_abmc.config.line_converge_offset.third_person_offset_z": "Third-person Z (forward) offset",
  "joes_addons_for_abmc.config.line_converge_offset.third_person_offset_z.tooltip": "Extra Z (forward) offset in blocks applied only in third person or when another holder uses the staff. Also relative to the holder's head direction; moves relatively when looking up or down. Range -10 to 10.",
  "joes_addons_for_abmc.config.chain": "Chain",
  "joes_addons_for_abmc.config.chain.chain_lift_strength": "Lift strength",
  "joes_addons_for_abmc.config.chain.chain_lift_strength.tooltip": "Vertical lift strength of the Chain (Iron Block) staff: how far a grabbed creature is raised when the player looks straight up (and lowered when looking down). 0 disables the lift effect. Range 0 to 10.",
  "joes_addons_for_abmc.config.start": "Starting Gift",
  "joes_addons_for_abmc.config.start.give_staff_on_start": "Give a staff on start",
  "joes_addons_for_abmc.config.start.give_staff_on_start.tooltip": "Whether to give the player a staff (with empty block type) when they first enter the world. Only granted once per player; when disabled, never granted."
